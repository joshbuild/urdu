{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urdu",
  "compatibility_date": "2026-08-22",
  // Urdu Core Worker. Built and served through @cloudflare/vite-plugin; `pnpm run deploy`
  // deploys the Vite build output (client assets + Worker) using this config.
  "main": "./worker/index.ts",
  // Preview URLs are on unless disabled, which publishes every deployed version at its own
  // <version>-urdu.umber-amber.workers.dev. Still secret-gated, but a single-user app has
  // no use for that extra surface (f01 carry-forward).
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "urdu",
      // Production D1 (WNAM). `pnpm dev` and tests use a local copy; only `--remote` commands touch this.
      "database_id": "3b3e3582-051e-47e6-a75b-a4d323e198b7",
      "migrations_dir": "migrations"
    }
  ],
  // Brute-force brake on POST /api/unlock (f01 Q1): 5 attempts per minute per client IP.
  // Counts are per Cloudflare location and approximate; the long secret is the real defence.
  "ratelimits": [
    {
      "name": "UNLOCK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Secret (not in this file): UNLOCK_SECRET, 24+ chars. Local: .dev.vars; production:
  // `pnpm wrangler secret put UNLOCK_SECRET`.
  "vars": {
    "HOME_TZ": "America/Vancouver"
  },
  "observability": { "enabled": true }
}
