{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urdu",
  "compatibility_date": "2026-08-22",
  // Urdu Core Worker. Built and served through @cloudflare/vite-plugin; `pnpm run deploy`
  // deploys the Vite build output (client assets + Worker) using this config.
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "urdu",
      // Production D1 (WNAM). `pnpm dev` and tests use a local copy; only `--remote` commands touch this.
      "database_id": "3b3e3582-051e-47e6-a75b-a4d323e198b7",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "HOME_TZ": "America/Vancouver"
  },
  "observability": { "enabled": true }
}
