{
  "name": "urdu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && node scripts/scan-bundle.mjs",
    "deploy": "vite build && wrangler deploy",
    "spike:check": "node spikes/gpt-live/check.js"
  },
  "dependencies": {
    "hono": "4.13.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.12",
    "wrangler": "4.129.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "undici@<7.29.1": "7.29.1",
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
